
# appearance
theme = Everforest Dark Hard

font-size = 18
#font-family = "FiraCode Nerd Font Mono"
font-family = "TX-02"

window-decoration = auto

# mac options
macos-option-as-alt = true
macos-non-native-fullscreen = false
macos-titlebar-style = tabs

# linux options
gtk-titlebar-style = tabs

# behavior
copy-on-select = true

window-width = 115
window-height = 45

window-padding-balance = true
#window-padding-color = extend
window-padding-y = 0,4

shell-integration = zsh

# tmux approximations
keybind = ctrl+b>x=close_surface
# panes
keybind = ctrl+b>shift+five=new_split:right
keybind = ctrl+b>shift+backslash=new_split:right
keybind = ctrl+b>shift+quote=new_split:down
keybind = ctrl+b>-=new_split:down
keybind = ctrl+b>shift+-=new_split:up
# pane navigation
keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>j=goto_split:bottom
keybind = ctrl+b>k=goto_split:top
keybind = ctrl+b>l=goto_split:right
# windows/tabs
keybind = ctrl+b>c=new_tab
keybind = ctrl+b>&=close_tab


